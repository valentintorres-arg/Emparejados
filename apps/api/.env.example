# Conexión a PostgreSQL. En el servidor, el host es el servicio "db" de
# docker-compose y el puerto interno 5432.
DATABASE_URL="postgresql://emparejados:cambiar-esta-clave@localhost:5440/emparejados?schema=public"

# Firma de los tokens de sesión. Generar uno propio y largo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

PORT=4000

# true en producción (HTTPS): las cookies de sesión solo viajan cifradas.
COOKIE_SECURE=false

# Primer administrador. Lo crea "npm run db:seed" si todavía no existe.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
