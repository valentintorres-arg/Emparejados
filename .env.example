# Variables de docker-compose. Copiar a .env y completar.
POSTGRES_USER=emparejados
# Solo letras y números: va dentro de la dirección de conexión.
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=emparejados
# Puerto de la base en el host. 5432 y 5433 ya están ocupados en el servidor.
DB_PORT=5440

# --- Solo para el servidor (API y web en contenedores) ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Notificaciones push (Web Push). Generarlas una sola vez y no cambiarlas: si cambian,
# los teléfonos que ya aceptaron los avisos dejan de recibirlos hasta volver a activarlos.
# docker compose run --rm --no-deps api node -e "const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\nVAPID_PRIVATE_KEY='+k.privateKey)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PORT=8084
# vacío = sin accesos de ejemplo; jugador = solo el del jugador; 1 = los dos.
NEXT_PUBLIC_DEMO=
